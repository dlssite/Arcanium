{
  "name": "@arcanium/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "prisma generate --schema=prisma/schema.prisma && tsc",
    "start": "node dist/services/backend/src/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@arcanium/types": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "bullmq": "^6.3.4",
    "cheerio": "^1.2.0",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-rate-limit": "7.4.0",
    "google-auth-library": "9.14.1",
    "helmet": "8.0.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "9.0.2",
    "node-html-parser": "^9.0.4",
    "openai": "4.67.3",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.7",
    "slugify": "^1.6.9",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cheerio": "^1.0.0",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.5.4",
    "@types/sanitize-html": "^2.16.1",
    "dotenv-cli": "7.4.2",
    "prisma": "5.19.1",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}
