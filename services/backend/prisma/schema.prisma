// services/backend/prisma/schema.prisma
// Single source of truth for the database schema.
// All changes via: pnpm --filter @arcanium/backend db:migrate
// Direct DB edits are forbidden (Constitution §5.3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is required by Supabase when using the transaction pooler (port 6543)
  // for connection-heavy operations like migrations.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum ContentType {
  WEB_NOVEL
  LIGHT_NOVEL
  COMIC
  MANGA
  EBOOK
  WEBTOON
}

enum ContentStatus {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
  UNKNOWN
}

enum ContentSource {
  SCRAPED
  CREATOR_UPLOAD
  ADMIN_UPLOAD
}

enum ReadingStatus {
  READING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_READ
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

enum UserRole {
  USER
  VERIFIED_WRITER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CircleVisibility {
  PUBLIC
  PRIVATE
}

enum CircleMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CircleMemberStatus {
  ACTIVE
  PENDING
  BANNED
}

enum CirclePostType {
  MARGINALIA
  DISCUSSION
}

enum CircleJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// USER
// ---------------------------------------------------------------------------

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String
  avatarUrl   String?
  bio         String?    @db.VarChar(300)
  gender      Gender?
  totalXp     Int        @default(0)
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authAccounts      AuthAccount[]
  shelves           Shelf[]
  readingProgress   ReadingProgress[]
  aiMemory          AiMemory?
  aiMoodEntries     AiMoodEntry[]
  aiActionLogs      AiActionLog[]
  badgeAwards       UserBadgeAward[]
  circleMemberships CircleMember[]      @relation("CircleMemberships")
  ownedCircles      ReadingCircle[]     @relation("OwnedCircles")
  circlePosts       CirclePost[]        @relation("CirclePosts")
  circlePostEchoes  CirclePostEcho[]    @relation("CirclePostEchoes")
  circlePostReplies CirclePostReply[]   @relation("CirclePostReplies")
  circleJoinReqs    CircleJoinRequest[] @relation("CircleJoinRequests")
  marginaliaPosts   MarginaliaPost[]    @relation("MarginaliaPost")
  createdContent    Content[]           @relation("CreatorContent")
  creatorApplications CreatorApplication[] @relation("CreatorApplications")
  moderatedContent  ModeratedContent[]  @relation("ModeratedAuthor")
  reviews           Review[]            @relation("UserReviews")
  reviewReactions   ReviewReaction[]    @relation("UserReviewReactions")
  xpEvents          XpEvent[]           @relation("UserXpEvents")

  @@index([email])
}

// ---------------------------------------------------------------------------
// AUTH ACCOUNTS
// Separates auth provider data from the core User identity.
// A single User can sign in via Google AND email/password.
// ---------------------------------------------------------------------------

model AuthAccount {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  // For GOOGLE: the Google `sub` claim. For EMAIL: null.
  providerId String?      @unique
  // For EMAIL: bcrypt hash. For GOOGLE: null.
  password   String?
  createdAt  DateTime     @default(now())

  @@unique([userId, provider])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CONTENT CATALOGUE
// ---------------------------------------------------------------------------

model Content {
  id            String        @id @default(cuid())
  type          ContentType
  status        ContentStatus @default(UNKNOWN)
  source        ContentSource @default(SCRAPED)
  title         String
  slug          String        @unique
  author        String?
  artist        String?
  synopsis      String?
  coverImageUrl String?
  language      String        @default("en")
  sourceUrl     String?
  sourceSite    String?
  metadata      Json          @default("{}")
  chapterCount  Int           @default(0)
  rating        Float?
  /// For CREATOR_UPLOAD content — the User who created it. Null for scraped.
  creatorId     String?
  creator       User?         @relation("CreatorContent", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  chapters          Chapter[]
  shelfEntries      ShelfEntry[]
  readingProgress   ReadingProgress[]
  moderatedContent  ModeratedContent[] @relation("ModeratedContent")
  featuredIn        FeaturedSection[]
  collectionEntries CollectionEntry[]
  reviews           Review[]          @relation("ContentReviews")
  
  // Denormalized aggregate rating (cached for performance)
  averageRating     Float?            // null = no reviews yet
  ratingCount       Int               @default(0)
  reviewCount       Int               @default(0)

  @@index([type])
  @@index([source])
  @@index([creatorId])
  @@index([sourceSite, sourceUrl])
  @@index([slug])
  @@index([averageRating])
}

// ---------------------------------------------------------------------------
// CHAPTER
// ---------------------------------------------------------------------------

model Chapter {
  id          String    @id @default(cuid())
  contentId   String
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  number      Float
  title       String?
  /// Full HTML/text body. Null for scraped chapters not yet fetched.
  /// For MANGA/COMIC/WEBTOON: JSON array of image URLs stored as text.
  bodyText    String?   @db.Text
  wordCount   Int       @default(0)
  /// false = draft (creator-only), true = visible to readers
  isPublished Boolean   @default(true)
  isDraft     Boolean   @default(false)
  /// External URL — null for creator-uploaded chapters
  sourceUrl   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([contentId, number])
  @@index([contentId])
  @@index([contentId, isPublished])
}

// ---------------------------------------------------------------------------
// LIBRARY — SHELVES
// ---------------------------------------------------------------------------

model Shelf {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries ShelfEntry[]

  @@unique([userId, name])
  @@index([userId])
}

model ShelfEntry {
  id        String   @id @default(cuid())
  shelfId   String
  shelf     Shelf    @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())
  sortOrder Int      @default(0)
  note      String?

  @@unique([shelfId, contentId])
  @@index([shelfId])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// READING PROGRESS
// ---------------------------------------------------------------------------

model ReadingProgress {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId       String
  content         Content       @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status          ReadingStatus @default(PLAN_TO_READ)
  lastChapterRead Float?
  lastReadAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  scrollPosition  Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([userId, contentId])
  @@index([userId, status])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// AI MEMORY
// ---------------------------------------------------------------------------

model AiMemory {
  id                String  @id @default(cuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferenceSummary String?
  preferences       Json    @default("{}")
  lastContext       Json    @default("{}")
  updatedAt         DateTime @updatedAt
}

model AiMoodEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood            String
  rawInput        String?
  recommendations Json     @default("[]")
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model AiActionLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolName   String
  inputArgs  Json
  result     Json
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([toolName])
}

// ---------------------------------------------------------------------------
// COMMUNITY
// ---------------------------------------------------------------------------

model ReadingCircle {
  id            String           @id @default(cuid())
  name          String
  tag           String
  description   String?          @db.VarChar(500)
  focusTitle    String?
  coverColor    String           @default("bg-purple-500")
  visibility    CircleVisibility @default(PUBLIC)
  isPublic      Boolean          @default(true)
  isFeatured    Boolean          @default(false)
  featuredOrder Int              @default(0)
  isArchived    Boolean          @default(false)

  // Ownership — every circle has exactly one owner
  ownerId       String
  owner         User             @relation("OwnedCircles", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  members      CircleMember[]
  sessions     CircleSession[]
  posts        CirclePost[]
  joinRequests CircleJoinRequest[]

  @@index([isPublic])
  @@index([isFeatured, featuredOrder])
  @@index([isArchived])
  @@index([ownerId])
}

model CircleMember {
  id        String             @id @default(cuid())
  circleId  String
  circle    ReadingCircle      @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation("CircleMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role      CircleMemberRole   @default(MEMBER)
  status    CircleMemberStatus @default(ACTIVE)
  joinedAt  DateTime           @default(now())

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
}

/// A live session snapshot — updated periodically, not a full audit log
model CircleSession {
  id          String        @id @default(cuid())
  circleId    String
  circle      ReadingCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  bookTitle   String?
  chapterHint String?
  activeNow   Int           @default(0)
  isActive    Boolean       @default(true)
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  updatedAt   DateTime      @updatedAt

  @@index([circleId, isActive])
}

model CirclePost {
  id         String         @id @default(cuid())
  circleId   String
  circle     ReadingCircle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation("CirclePosts", fields: [authorId], references: [id], onDelete: Cascade)

  type       CirclePostType

  // MARGINALIA fields
  quote      String?        @db.Text
  chapter    String?
  reflection String?        @db.Text

  // DISCUSSION fields
  title      String?
  body       String?        @db.Text

  echoCount  Int            @default(0)
  replyCount Int            @default(0)
  isPinned   Boolean        @default(false)
  isRemoved  Boolean        @default(false)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  echoes     CirclePostEcho[]
  replies    CirclePostReply[]

  @@index([circleId, createdAt])
  @@index([circleId, isRemoved])
  @@index([authorId])
}

model CirclePostEcho {
  id        String     @id @default(cuid())
  postId    String
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("CirclePostEchoes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CirclePostReply {
  id        String     @id @default(cuid())
  postId    String
  post      CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("CirclePostReplies", fields: [authorId], references: [id], onDelete: Cascade)
  body      String     @db.Text
  isRemoved Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
}

model CircleJoinRequest {
  id          String                  @id @default(cuid())
  circleId    String
  circle      ReadingCircle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation("CircleJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  message     String?                 @db.VarChar(300)
  status      CircleJoinRequestStatus @default(PENDING)
  reviewedBy  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([circleId, userId])
  @@index([circleId, status])
  @@index([userId])
}

model MarginaliaPost {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("MarginaliaPost", fields: [authorId], references: [id], onDelete: Cascade)
  bookTitle  String
  chapter    String?
  quote      String
  reflection String
  echoCount  Int      @default(0)
  replyCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model CommunityChallenge {
  id               String   @id @default(cuid())
  title            String
  description      String
  targetPages      Int
  completedPages   Int      @default(0)
  badgeReward      String
  totalScholars    Int      @default(0)
  startsAt         DateTime
  endsAt           DateTime
  createdAt        DateTime @default(now())

  @@index([endsAt])
}

// ---------------------------------------------------------------------------
// CREATOR APPLICATIONS
// ---------------------------------------------------------------------------

enum CreatorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CreatorApplication {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation("CreatorApplications", fields: [userId], references: [id], onDelete: Cascade)
  applicantName  String
  penName        String
  email          String
  portfolioUrl   String?
  sampleTitle    String
  sampleSynopsis String                   @db.Text
  pitch          String                   @db.Text
  primaryGenre   String
  status         CreatorApplicationStatus @default(PENDING)
  submittedAt    DateTime                 @default(now())
  reviewedAt     DateTime?
  reviewedById   String?

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// CONTENT MODERATION
// ---------------------------------------------------------------------------

enum ModerationStatus {
  FLAGGED
  APPROVED
  QUARANTINED
}

model ModeratedContent {
  id           String           @id @default(cuid())
  contentId    String
  content      Content          @relation("ModeratedContent", fields: [contentId], references: [id], onDelete: Cascade)
  authorId     String
  author       User             @relation("ModeratedAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  flagReason   String
  riskScore    Float            @default(0)
  status       ModerationStatus @default(FLAGGED)
  reportedAt   DateTime         @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@index([status])
  @@index([contentId])
}

// ---------------------------------------------------------------------------
// FEATURE FLAGS
// ---------------------------------------------------------------------------

enum FeatureFlagCategory {
  AI_LIBER
  CREATOR_ECONOMY
  CORE_READER
  SYSTEM
}

model FeatureFlag {
  key         String              @id
  name        String
  description String
  category    FeatureFlagCategory @default(SYSTEM)
  enabled     Boolean             @default(false)
  rolloutPct  Int                 @default(0)
  updatedById String?
  updatedAt   DateTime            @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// SCRAPER CONFIG
// ---------------------------------------------------------------------------

enum ScraperStatus {
  OPERATIONAL
  DEGRADED
  FAILED
}

enum SelectorType {
  CHEERIO
  REST
  READABILITY
}

model ScraperConfig {
  id                  String         @id @default(cuid())
  name                String
  targetDomain        String         @unique
  selectorType        SelectorType
  enabled             Boolean        @default(true)
  requestDelayMs      Int            @default(1000)
  lastRunAt           DateTime?
  lastRunStatus       ScraperStatus?
  totalCrawledAllTime Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([enabled])
}

// ---------------------------------------------------------------------------
// CONTENT TAXONOMY
// Admin-managed genre/category labels surfaced to the web app as filter chips.
// The `genre` field is the exact string used in Content.metadata.genres[] so
// the public /api/v1/content?genre= filter works without any mapping layer.
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String   @unique          // display label, e.g. "Dark Fantasy"
  genre     String   @unique          // exact value matched in metadata.genres[]
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// ---------------------------------------------------------------------------
// APP CONFIG
// Generic key-value store for runtime-editable application settings.
// Used for AI model selection, rate limits, etc.
// ---------------------------------------------------------------------------

model AppConfig {
  key       String   @id            // e.g. "ai_model"
  value     String                  // e.g. "google/gemini-flash-1.5"
  updatedAt DateTime @updatedAt
  updatedBy String?                 // admin user id who last changed it
}

// ---------------------------------------------------------------------------
// BADGE / HONOR SYSTEM
// Badge       — catalog of badge definitions managed by admins
// UserBadgeAward — explicit admin award for a specific user (overrides computed)
// ---------------------------------------------------------------------------

model Badge {
  id           String   @id @default(cuid())
  key          String   @unique             // stable id, e.g. "night_owl"
  title        String
  description  String
  iconName     String                       // lucide icon name, e.g. "Moon"
  colorClasses String                       // tailwind classes for color
  tier         String   @default("Bronze Talisman")
  // If criteria is set, it's a display-only hint for auto-unlock logic
  criteria     String?
  // Manual-only badges can only be awarded by admins, never auto-unlocked
  manualOnly   Boolean  @default(false)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  awards       UserBadgeAward[]

  @@index([enabled, sortOrder])
}

model UserBadgeAward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedBy   String?                      // admin user id
  note        String?                      // optional reason
  awardedAt   DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ---------------------------------------------------------------------------
// FEATURED CONTENT CURATION
// Admin pins specific content items to named slots (sections).
// key examples: "home_featured", "explore_spotlight"
// Multiple items per section — sortOrder controls display order.
// ---------------------------------------------------------------------------

model FeaturedSection {
  id        String   @id @default(cuid())
  key       String                        // section identifier, e.g. "home_featured"
  label     String                        // display label, e.g. "Featured for You"
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  pinnedBy  String?                       // admin user id
  pinnedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, contentId])
  @@index([key, enabled, sortOrder])
}

// ---------------------------------------------------------------------------
// SPECIAL COLLECTIONS
// Admin-curated named collections of books (e.g. "Grimoires & Spells").
// Shown in the web app sidebar and as dedicated collection pages.
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique           // URL-safe identifier
  description String   @default("")
  coverColor  String   @default("bg-purple-400") // Tailwind color class for sidebar dot
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdBy   String?                    // admin user id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries     CollectionEntry[]

  @@index([enabled, sortOrder])
}

model CollectionEntry {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentId    String
  content      Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, contentId])
  @@index([collectionId, sortOrder])
}

// ---------------------------------------------------------------------------
// BOOK REVIEWS & RATINGS
// Catalog-level feature: users rate and review books they've read.
// Reviews are tied to Content records (not chapters or community circles).
// ---------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  contentId  String
  content    Content  @relation("ContentReviews", fields: [contentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  
  // Star rating (1-5 stars)
  rating     Int      // validated 1..5 in Zod + application layer
  
  // Optional written reflection (50-2000 characters if provided)
  reviewText String?  @db.Text
  
  // Engagement metric: how many users found this review helpful
  echoCount  Int      @default(0)
  
  // Timestamps
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  echoes     ReviewReaction[] @relation("ReviewEchoes")
  
  @@unique([contentId, userId]) // 1 review per user per book (can update existing)
  @@index([contentId, createdAt])
  @@index([userId])
  @@index([rating])
}

model ReviewReaction {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation("ReviewEchoes", fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("UserReviewReactions", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([reviewId, userId]) // 1 echo per user per review (toggle on/off)
  @@index([reviewId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// DEFAULT AVATARS
// Admin-managed list of preset avatar images users can pick from.
// ---------------------------------------------------------------------------

model DefaultAvatar {
  id        String   @id @default(cuid())
  url       String
  label     String   @default("")
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// ---------------------------------------------------------------------------
// XP EVENTS
// Append-only audit log of every XP grant.
// ---------------------------------------------------------------------------

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserXpEvents", fields: [userId], references: [id], onDelete: Cascade)
  source    String   // e.g. "BOOK_COMPLETE", "CHAPTER_READ", "REVIEW_SUBMIT"
  amount    Int
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, source])
}

// ---------------------------------------------------------------------------
// RANK DEFINITIONS
// Admin-managed — each row defines one of the 10 (or more) ranks.
// ---------------------------------------------------------------------------

model RankDefinition {
  id          String   @id @default(cuid())
  level       Int      @unique
  title       String
  xpRequired  Int
  icon        String   @default("Scroll")
  colorClass  String   @default("text-stone-500")
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
}
