{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "lib": ["ES2022"],
    "baseUrl": ".",
    "paths": {
      "@arcanium/types": ["../../packages/types/src/index.ts"],
      "@arcanium/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src/**/*", "../../packages/types/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
