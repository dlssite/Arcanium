# =============================================================================
# apps/web — Vite environment variables
# Copy to .env and fill in values. NEVER commit .env.
# All VITE_ vars are bundled into the browser build — never put secrets here.
# =============================================================================

# The backend API URL as seen from the browser
VITE_API_BASE_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# Feature Flags — set to "false" to disable. Default: all enabled (true).
# -----------------------------------------------------------------------------

# Liber AI companion tab, companion dock, and all chat surfaces
VITE_FEATURE_FLAG_AI_HOUSEKEEPER="true"

# Community tab and community feed
VITE_FEATURE_FLAG_COMMUNITY="true"

# "Begin Reading" links to the reader route (/read/:slug/:chapter)
VITE_FEATURE_FLAG_READER="true"

# Mic button in Liber chat (Web Speech API voice input)
VITE_FEATURE_FLAG_VOICE_INPUT="true"
