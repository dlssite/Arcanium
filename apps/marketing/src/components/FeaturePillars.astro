---
// FeaturePillars.astro
---

<section id="features" class="py-20 md:py-28 bg-[#F4EFEB]/50 dark:bg-[#16111F] relative border-y border-arcanium-border/70 dark:border-arcanium-dark-border/70 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-arcanium-purple-subtle dark:bg-purple-950/50 text-arcanium-purple dark:text-arcanium-purple-light text-xs font-bold uppercase tracking-wider mb-3">
        Engineered for Readers & Archivists
      </div>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-arcanium-plum dark:text-arcanium-dark-text tracking-tight">
        A Sanctuary Built for Pure Reading
      </h2>
      <p class="mt-4 text-base sm:text-lg text-arcanium-muted dark:text-arcanium-dark-muted">
        Traditional reading apps are cluttered with ads, paywalls, and fragmented formats. Arcanium unifies everything into one intelligent sanctuary.
      </p>
    </div>

    <!-- 3-Column Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      
      <!-- Card 1: Liber the Librarian (Agentic AI) -->
      <div class="bg-white dark:bg-arcanium-dark-card rounded-3xl p-8 border border-arcanium-border dark:border-arcanium-dark-border shadow-soft-card dark:shadow-dark-card hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-arcanium-amber/10 dark:bg-amber-500/10 rounded-full blur-2xl group-hover:bg-arcanium-amber/20 transition-all"></div>
        
        <div>
          <!-- Icon & Mascot Anchor -->
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-arcanium-amber-light dark:bg-amber-950/50 border border-arcanium-amber/30 flex items-center justify-center text-arcanium-amber shadow-xs group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                <line x1="12" x2="12" y1="19" y2="22"/>
              </svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-arcanium-purple-subtle dark:bg-purple-950/60 text-arcanium-purple dark:text-arcanium-purple-light">
              Agentic AI
            </span>
          </div>

          <h3 class="font-heading font-bold text-2xl text-arcanium-plum dark:text-arcanium-dark-text group-hover:text-arcanium-purple dark:group-hover:text-arcanium-purple-light transition-colors">
            Liber the Librarian
          </h3>

          <p class="mt-3 text-sm text-arcanium-muted dark:text-arcanium-dark-muted leading-relaxed">
            An AI companion that understands your reading mood, recommends stories, and manages your library shelves through simple voice or text.
          </p>

          <!-- Feature Bullets -->
          <ul class="mt-6 space-y-2.5 text-xs text-arcanium-text/90 dark:text-arcanium-dark-text/90 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Contextual mood matching & deep analysis</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Voice commands & natural read-aloud excerpts</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Autonomous shelf curation & tag sorting</span>
            </li>
          </ul>
        </div>

        <!-- Mascot Tag preview -->
        <div class="mt-8 pt-5 border-t border-arcanium-border dark:border-arcanium-dark-border flex items-center gap-3">
          <img src="/assets/capybara_reading.png" alt="Liber capybara icon" class="w-8 h-8 rounded-full bg-arcanium-cream dark:bg-arcanium-dark-surface p-0.5 border border-arcanium-border dark:border-arcanium-dark-border" />
          <span class="text-xs italic text-arcanium-muted dark:text-arcanium-dark-muted">"Ready to organize your next reading journey."</span>
        </div>
      </div>

      <!-- Card 2: Universal Reader Engine -->
      <div class="bg-white dark:bg-arcanium-dark-card rounded-3xl p-8 border border-arcanium-border dark:border-arcanium-dark-border shadow-soft-card dark:shadow-dark-card hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-arcanium-purple/10 dark:bg-arcanium-purple/20 rounded-full blur-2xl group-hover:bg-arcanium-purple/20 transition-all"></div>
        
        <div>
          <!-- Icon -->
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-arcanium-purple-subtle dark:bg-purple-950/50 border border-arcanium-purple/30 flex items-center justify-center text-arcanium-purple dark:text-arcanium-purple-light shadow-xs group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
              Clean Engine
            </span>
          </div>

          <h3 class="font-heading font-bold text-2xl text-arcanium-plum dark:text-arcanium-dark-text group-hover:text-arcanium-purple dark:group-hover:text-arcanium-purple-light transition-colors">
            Universal Reader Engine
          </h3>

          <p class="mt-3 text-sm text-arcanium-muted dark:text-arcanium-dark-muted leading-relaxed">
            Read across web novel sites, comics, and light novels in a clean, distraction-free native reader view with custom typography and offline caching.
          </p>

          <!-- Feature Bullets -->
          <ul class="mt-6 space-y-2.5 text-xs text-arcanium-text/90 dark:text-arcanium-dark-text/90 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Distraction-free typography & parchment modes</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Web novel parsers + Comic webtoon continuous scroll</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Zero telemetry, zero banner ads, instant loading</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-5 border-t border-arcanium-border dark:border-arcanium-dark-border flex items-center gap-2 text-xs font-semibold text-arcanium-purple dark:text-arcanium-purple-light">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>EPUB, CBZ, Web Novels & Manhwa supported</span>
        </div>
      </div>

      <!-- Card 3: Modular Library & Sync -->
      <div class="bg-white dark:bg-arcanium-dark-card rounded-3xl p-8 border border-arcanium-border dark:border-arcanium-dark-border shadow-soft-card dark:shadow-dark-card hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-32 h-32 bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
        
        <div>
          <!-- Icon -->
          <div class="flex items-center justify-between mb-6">
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 flex items-center justify-center text-emerald-700 dark:text-emerald-400 shadow-xs group-hover:scale-110 transition-transform">
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
                <path d="M16 21h5v-5"/>
              </svg>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-arcanium-amber-light dark:bg-amber-950/50 text-arcanium-amber border border-arcanium-amber/20">
              Cross-Device
            </span>
          </div>

          <h3 class="font-heading font-bold text-2xl text-arcanium-plum dark:text-arcanium-dark-text group-hover:text-arcanium-purple dark:group-hover:text-arcanium-purple-light transition-colors">
            Modular Library & Sync
          </h3>

          <p class="mt-3 text-sm text-arcanium-muted dark:text-arcanium-dark-muted leading-relaxed">
            Track reading progress, custom collections, and streaks seamlessly across all your devices with end-to-end cloud and local-first architecture.
          </p>

          <!-- Feature Bullets -->
          <ul class="mt-6 space-y-2.5 text-xs text-arcanium-text/90 dark:text-arcanium-dark-text/90 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Local-first offline storage via IndexedDB & SQLite</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Daily goal streaks & detailed reading analytics</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-5 h-5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Custom shelves, reading tags, and personal notes</span>
            </li>
          </ul>
        </div>

        <div class="mt-8 pt-5 border-t border-arcanium-border dark:border-arcanium-dark-border flex items-center gap-2 text-xs font-semibold text-arcanium-plum dark:text-arcanium-dark-text">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Instant sync across Phone, Tablet & Desktop</span>
        </div>
      </div>

    </div>

  </div>
</section>
