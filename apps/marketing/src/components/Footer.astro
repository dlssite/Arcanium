---
// Footer.astro
const currentYear = new Date().getFullYear();
const webAppUrl = import.meta.env.PUBLIC_WEB_APP_URL ?? 'http://localhost:3000';
const discordUrl = import.meta.env.PUBLIC_DISCORD_URL ?? 'https://discord.gg/arcanium';
const twitterUrl = import.meta.env.PUBLIC_TWITTER_URL ?? 'https://twitter.com/ArcaniumArchive';
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL ?? 'https://github.com/arcanium-archive';
---

<footer class="bg-white dark:bg-arcanium-dark-surface border-t border-arcanium-border/80 dark:border-arcanium-dark-border/80 pt-16 pb-12 text-arcanium-muted dark:text-arcanium-dark-muted text-sm transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-arcanium-border dark:border-arcanium-dark-border">
      
      <!-- Column 1: Brand & Bio -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-arcanium-plum dark:bg-arcanium-purple flex items-center justify-center text-amber-300 shadow-xs border border-arcanium-amber/30">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
              <path d="M6 6h10"/>
              <path d="M6 10h10"/>
              <path d="M12 14l2 2 4-4"/>
            </svg>
          </div>
          <span class="font-heading font-bold text-2xl text-arcanium-plum dark:text-arcanium-dark-text">Arcanium</span>
        </div>

        <p class="text-xs leading-relaxed max-w-sm">
          The Living Archive — Unifying digital literature, web novels, comics, and personal reading notes in a distraction-free sanctuary powered by Liber the AI Librarian.
        </p>

        <div class="flex items-center gap-3 pt-2">
          <!-- Discord -->
          <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-arcanium-cream dark:bg-arcanium-dark-card flex items-center justify-center text-arcanium-plum dark:text-arcanium-dark-text hover:bg-arcanium-purple hover:text-white transition-colors" title="Discord">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </a>
          <!-- Twitter / X -->
          <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-arcanium-cream dark:bg-arcanium-dark-card flex items-center justify-center text-arcanium-plum dark:text-arcanium-dark-text hover:bg-arcanium-purple hover:text-white transition-colors" title="Twitter">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <!-- GitHub -->
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-lg bg-arcanium-cream dark:bg-arcanium-dark-card flex items-center justify-center text-arcanium-plum dark:text-arcanium-dark-text hover:bg-arcanium-purple hover:text-white transition-colors" title="GitHub">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Product -->
      <div class="space-y-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-arcanium-plum dark:text-arcanium-dark-text">Product</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="#features" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Universal Reader</a></li>
          <li><a href="#liber" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Liber AI Companion</a></li>
          <li><a href="#showcase" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Living Dashboard</a></li>
          <li><a href="#creators" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Writer Pipeline</a></li>
          <li><a href={webAppUrl} class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light font-semibold text-arcanium-plum dark:text-arcanium-dark-text transition-colors">Launch Web App →</a></li>
        </ul>
      </div>

      <!-- Column 3: Community -->
      <div class="space-y-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-arcanium-plum dark:text-arcanium-dark-text">Community</h5>
        <ul class="space-y-2 text-xs">
          <li><a href={discordUrl} target="_blank" rel="noopener noreferrer" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Discord Guild</a></li>
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Archivist Book Clubs</a></li>
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Feature Roadmap</a></li>
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Liber Voice Beta</a></li>
        </ul>
      </div>

      <!-- Column 4: Legal & Architecture -->
      <div class="space-y-3">
        <h5 class="text-xs font-bold uppercase tracking-wider text-arcanium-plum dark:text-arcanium-dark-text">Archival Trust</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Terms of Service</a></li>
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Local-First Architecture</a></li>
          <li><a href="#" class="hover:text-arcanium-purple dark:hover:text-arcanium-purple-light transition-colors">Content Guidelines</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs gap-4">
      <p>© {currentYear} Arcanium. All rights reserved. Crafted with care for the quiet hours of reading.</p>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-arcanium-plum dark:text-arcanium-dark-text">Archive Systems Operational</span>
      </div>
    </div>

  </div>
</footer>
