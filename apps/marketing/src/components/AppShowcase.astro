---
// AppShowcase.astro
---

<section id="showcase" class="py-20 md:py-32 bg-[#FAF8F5] dark:bg-[#120E18] relative overflow-hidden transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-arcanium-amber-light dark:bg-amber-950/40 text-arcanium-amber text-xs font-bold uppercase tracking-wider mb-3 border border-arcanium-amber/20">
        Live Interface Preview
      </div>
      <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-arcanium-plum dark:text-arcanium-dark-text tracking-tight">
        Step Inside The Living Archive
      </h2>
      <p class="mt-4 text-base sm:text-lg text-arcanium-muted dark:text-arcanium-dark-muted">
        Experience the thoughtful fusion of classic literary warmth and cutting-edge digital intelligence.
      </p>

      <!-- Interactive Tab Switcher -->
      <div class="mt-8 inline-flex p-1.5 rounded-2xl bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border shadow-soft-card dark:shadow-dark-card">
        <button 
          id="tab-btn-dashboard"
          class="tab-trigger active px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center gap-2 bg-arcanium-plum dark:bg-arcanium-purple text-white shadow-xs"
          data-target="panel-dashboard"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
          </svg>
          <span>The Living Archive (Dashboard)</span>
        </button>

        <button 
          id="tab-btn-liber"
          class="tab-trigger px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 flex items-center gap-2 text-arcanium-muted dark:text-arcanium-dark-muted hover:text-arcanium-plum dark:hover:text-white hover:bg-arcanium-cream dark:hover:bg-arcanium-dark-surface"
          data-target="panel-liber"
        >
          <svg class="w-4 h-4 text-arcanium-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
          </svg>
          <span>Liber's Study (Voice & AI Companion)</span>
        </button>
      </div>
    </div>

    <!-- Showcase Container -->
    <div class="max-w-5xl mx-auto">
      
      <!-- TAB 1: THE LIVING ARCHIVE (DASHBOARD) -->
      <div id="panel-dashboard" class="tab-panel transition-all duration-300">
        <div class="bg-white dark:bg-arcanium-dark-card rounded-3xl border border-arcanium-border dark:border-arcanium-dark-border shadow-2xl dark:shadow-dark-card p-6 sm:p-8 lg:p-10 relative overflow-hidden">
          
          <!-- Top Row: Welcome & Ambient Stats -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-arcanium-border dark:border-arcanium-dark-border gap-4">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl overflow-hidden shadow-xs border-2 border-arcanium-purple/20">
                <img src="/assets/avatar.png" alt="Archivist avatar" class="w-full h-full object-cover" />
              </div>
              <div>
                <h3 class="font-heading font-bold text-2xl text-arcanium-plum dark:text-arcanium-dark-text">Archivist Elena</h3>
                <p class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted">Level 12 Chronicler • 42 books read this year</p>
              </div>
            </div>

            <!-- Reading Stats Badges -->
            <div class="flex items-center gap-3">
              <div class="bg-arcanium-amber-light dark:bg-amber-950/40 px-4 py-2 rounded-xl border border-arcanium-amber/30 flex items-center gap-2">
                <span class="text-base">🔥</span>
                <div class="text-left">
                  <div class="text-[10px] uppercase font-bold text-arcanium-amber">Streak</div>
                  <div class="text-xs font-bold text-arcanium-plum dark:text-arcanium-dark-text">14 Days</div>
                </div>
              </div>

              <div class="bg-arcanium-purple-subtle dark:bg-purple-950/50 px-4 py-2 rounded-xl border border-arcanium-purple/30 flex items-center gap-2">
                <span class="text-base">⏱</span>
                <div class="text-left">
                  <div class="text-[10px] uppercase font-bold text-arcanium-purple dark:text-arcanium-purple-light">Today's Goal</div>
                  <div class="text-xs font-bold text-arcanium-plum dark:text-arcanium-dark-text">38 / 45 min</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Middle Row: Currently Reading Showcase -->
          <div class="py-6 border-b border-arcanium-border dark:border-arcanium-dark-border">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold tracking-wider uppercase text-arcanium-muted dark:text-arcanium-dark-muted">Active Manuscripts</span>
              <span class="text-xs font-semibold text-arcanium-purple dark:text-arcanium-purple-light hover:underline cursor-pointer">Manage Shelves (8)</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Book 1 -->
              <div class="bg-[#FAF8F5] dark:bg-arcanium-dark-surface p-4 rounded-2xl border border-arcanium-border dark:border-arcanium-dark-border flex gap-4 items-center">
                <img src="/assets/cover_archive.png" alt="Cover" class="w-16 h-22 object-cover rounded-lg shadow-sm" />
                <div class="flex-1 min-w-0">
                  <span class="text-[10px] font-bold text-arcanium-purple dark:text-arcanium-purple-light uppercase">Web Novel</span>
                  <h4 class="font-heading font-bold text-base text-arcanium-plum dark:text-arcanium-dark-text truncate">The Chrono-Archivist</h4>
                  <p class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted mt-0.5">Chapter 42: The Library of Sands</p>
                  <div class="mt-2.5">
                    <div class="flex justify-between text-[10px] font-semibold text-arcanium-muted dark:text-arcanium-dark-muted mb-1">
                      <span>Progress</span>
                      <span>68%</span>
                    </div>
                    <div class="w-full h-1.5 bg-arcanium-border dark:bg-arcanium-dark-border rounded-full overflow-hidden">
                      <div class="w-[68%] h-full bg-arcanium-purple rounded-full"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Book 2 -->
              <div class="bg-[#FAF8F5] dark:bg-arcanium-dark-surface p-4 rounded-2xl border border-arcanium-border dark:border-arcanium-dark-border flex gap-4 items-center">
                <img src="/assets/cover_charlotte.png" alt="Cover" class="w-16 h-22 object-cover rounded-lg shadow-sm" />
                <div class="flex-1 min-w-0">
                  <span class="text-[10px] font-bold text-emerald-700 dark:text-emerald-400 uppercase">Classic / Light Novel</span>
                  <h4 class="font-heading font-bold text-base text-arcanium-plum dark:text-arcanium-dark-text truncate">Charlotte's Constellation</h4>
                  <p class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted mt-0.5">Chapter 19: The Silver Telescope</p>
                  <div class="mt-2.5">
                    <div class="flex justify-between text-[10px] font-semibold text-arcanium-muted dark:text-arcanium-dark-muted mb-1">
                      <span>Progress</span>
                      <span>84%</span>
                    </div>
                    <div class="w-full h-1.5 bg-arcanium-border dark:bg-arcanium-dark-border rounded-full overflow-hidden">
                      <div class="w-[84%] h-full bg-emerald-600 dark:bg-emerald-500 rounded-full"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Row: Ambient Music & Reader Controls Preview -->
          <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-arcanium-muted dark:text-arcanium-dark-muted">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-arcanium-purple/10 dark:bg-arcanium-purple/20 text-arcanium-purple dark:text-arcanium-purple-light flex items-center justify-center">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 18V5l12-2v13"/>
                  <circle cx="6" cy="18" r="3"/>
                  <circle cx="18" cy="16" r="3"/>
                </svg>
              </div>
              <div>
                <span class="font-bold text-arcanium-plum dark:text-arcanium-dark-text">Study Audio:</span>
                <span> Rain on Glass & Antique Clock (432Hz)</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-md bg-white dark:bg-arcanium-dark-surface border border-arcanium-border dark:border-arcanium-dark-border font-mono text-[11px]">Parchment Theme</span>
              <span class="px-2.5 py-1 rounded-md bg-white dark:bg-arcanium-dark-surface border border-arcanium-border dark:border-arcanium-dark-border font-mono text-[11px]">Bionic: Off</span>
              <span class="px-2.5 py-1 rounded-md bg-white dark:bg-arcanium-dark-surface border border-arcanium-border dark:border-arcanium-dark-border font-mono text-[11px]">Font: Garamond</span>
            </div>
          </div>

        </div>
      </div>

      <!-- TAB 2: LIBER'S STUDY (VOICE & TEXT AI COMPANION) -->
      <div id="panel-liber" class="tab-panel hidden transition-all duration-300">
        <div class="bg-white dark:bg-arcanium-dark-card rounded-3xl border border-arcanium-border dark:border-arcanium-dark-border shadow-2xl dark:shadow-dark-card p-6 sm:p-8 lg:p-10 relative overflow-hidden">
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Left: High-Res Liber Portrait in His Study -->
            <div class="lg:col-span-5 relative group">
              <div class="rounded-2xl overflow-hidden border-2 border-arcanium-amber/40 shadow-xl relative aspect-square max-w-sm mx-auto">
                <img 
                  src="/assets/liber_hero.jpg" 
                  alt="Liber the Librarian in his cozy study" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-arcanium-plum/80 dark:from-arcanium-dark-bg/90 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 text-white">
                  <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/80 backdrop-blur-sm text-[10px] font-bold uppercase mb-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></span>
                    <span>Listening & Reflecting</span>
                  </div>
                  <h4 class="font-heading font-bold text-xl">Liber the Librarian</h4>
                  <p class="text-xs text-amber-200/90">"Every story has a soul; I merely keep the lanterns lit."</p>
                </div>
              </div>
            </div>

            <!-- Right: Interactive Conversation & Voice Capability -->
            <div class="lg:col-span-7 space-y-4">
              
              <!-- Voice Activity Visualizer -->
              <div class="bg-[#FAF8F5] dark:bg-arcanium-dark-surface p-4 rounded-2xl border border-arcanium-border dark:border-arcanium-dark-border flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-arcanium-purple text-white flex items-center justify-center shadow-xs">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    </svg>
                  </div>
                  <div>
                    <h5 class="text-xs font-bold text-arcanium-plum dark:text-arcanium-dark-text">Liber Voice Neural Engine</h5>
                    <p class="text-[11px] text-arcanium-muted dark:text-arcanium-dark-muted">Natural conversational voice synthesis & audio reflections</p>
                  </div>
                </div>

                <!-- Simulated Sound Wave -->
                <div class="flex items-center gap-1">
                  <span class="w-1 h-3 bg-arcanium-amber rounded-full animate-pulse"></span>
                  <span class="w-1 h-6 bg-arcanium-purple rounded-full animate-pulse delay-75"></span>
                  <span class="w-1 h-8 bg-arcanium-plum dark:bg-amber-300 rounded-full animate-pulse delay-150"></span>
                  <span class="w-1 h-5 bg-arcanium-purple rounded-full animate-pulse delay-100"></span>
                  <span class="w-1 h-2 bg-arcanium-amber rounded-full animate-pulse delay-200"></span>
                </div>
              </div>

              <!-- Conversation Thread -->
              <div class="space-y-3 bg-arcanium-cream/40 dark:bg-arcanium-dark-surface/60 p-4 rounded-2xl border border-arcanium-border/80 dark:border-arcanium-dark-border">
                <div class="flex justify-end">
                  <div class="bg-arcanium-purple text-white text-xs px-4 py-2.5 rounded-2xl rounded-tr-xs max-w-[85%] shadow-xs">
                    "Liber, summarize the philosophy behind the Cartographer's map without spoiling the ending."
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <img src="/assets/capybara_reading.png" alt="Liber avatar" class="w-8 h-8 rounded-full bg-white dark:bg-arcanium-dark-card p-0.5 border border-arcanium-border dark:border-arcanium-dark-border" />
                  <div class="bg-white dark:bg-arcanium-dark-card p-3.5 rounded-2xl rounded-tl-xs border border-arcanium-border dark:border-arcanium-dark-border text-xs text-arcanium-text dark:text-arcanium-dark-text space-y-2">
                    <p>
                      "With pleasure, Archivist. In the world of the Cartographer, space is not measured in leagues, but in emotional resonance. When the protagonist draws a mountain, he is mapping his unresolved grief. To read this story is to understand that we only wander when we refuse to name what we have lost."
                    </p>
                    <div class="flex items-center gap-2 pt-1">
                      <span class="text-[10px] text-arcanium-purple dark:text-arcanium-purple-light font-semibold bg-arcanium-purple-subtle dark:bg-purple-950/60 px-2 py-0.5 rounded-md">
                        ✓ Cross-referenced with your reading notes
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Sample Prompt Chips -->
              <div>
                <span class="text-[11px] font-bold text-arcanium-muted dark:text-arcanium-dark-muted uppercase tracking-wider block mb-2">Try asking Liber:</span>
                <div class="flex flex-wrap gap-2">
                  <button class="px-3 py-1.5 rounded-xl bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border text-xs text-arcanium-plum dark:text-arcanium-dark-text hover:border-arcanium-purple dark:hover:border-arcanium-purple-light hover:text-arcanium-purple transition-all shadow-xs">
                    ✨ "Find cozy novels like The Starless Sea"
                  </button>
                  <button class="px-3 py-1.5 rounded-xl bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border text-xs text-arcanium-plum dark:text-arcanium-dark-text hover:border-arcanium-purple dark:hover:border-arcanium-purple-light hover:text-arcanium-purple transition-all shadow-xs">
                    🎙 "Read chapter 3 aloud in a calm voice"
                  </button>
                  <button class="px-3 py-1.5 rounded-xl bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border text-xs text-arcanium-plum dark:text-arcanium-dark-text hover:border-arcanium-purple dark:hover:border-arcanium-purple-light hover:text-arcanium-purple transition-all shadow-xs">
                    📂 "Sort unread web novels by chapter count"
                  </button>
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const tabDashboard = document.getElementById('tab-btn-dashboard');
  const tabLiber = document.getElementById('tab-btn-liber');
  const panelDashboard = document.getElementById('panel-dashboard');
  const panelLiber = document.getElementById('panel-liber');

  function selectTab(activeBtn, inactiveBtn, showPanel, hidePanel) {
    activeBtn.classList.add('bg-arcanium-plum', 'dark:bg-arcanium-purple', 'text-white', 'shadow-xs');
    activeBtn.classList.remove('text-arcanium-muted', 'dark:text-arcanium-dark-muted', 'hover:bg-arcanium-cream', 'dark:hover:bg-arcanium-dark-surface', 'hover:text-arcanium-plum', 'dark:hover:text-white');
    
    inactiveBtn.classList.remove('bg-arcanium-plum', 'dark:bg-arcanium-purple', 'text-white', 'shadow-xs');
    inactiveBtn.classList.add('text-arcanium-muted', 'dark:text-arcanium-dark-muted', 'hover:bg-arcanium-cream', 'dark:hover:bg-arcanium-dark-surface', 'hover:text-arcanium-plum', 'dark:hover:text-white');

    showPanel.classList.remove('hidden');
    hidePanel.classList.add('hidden');
  }

  if (tabDashboard && tabLiber && panelDashboard && panelLiber) {
    tabDashboard.addEventListener('click', () => {
      selectTab(tabDashboard, tabLiber, panelDashboard, panelLiber);
    });

    tabLiber.addEventListener('click', () => {
      selectTab(tabLiber, tabDashboard, panelLiber, panelDashboard);
    });
  }
</script>
