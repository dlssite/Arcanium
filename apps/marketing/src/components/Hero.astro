---
// Hero.astro
const webAppUrl = import.meta.env.PUBLIC_WEB_APP_URL ?? 'http://localhost:3000';
const discordUrl = import.meta.env.PUBLIC_DISCORD_URL ?? 'https://discord.gg/arcanium';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden transition-colors duration-200">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[400px] bg-gradient-to-tr from-arcanium-purple/15 dark:from-arcanium-purple/25 via-arcanium-amber/10 dark:via-arcanium-purple/10 to-transparent blur-3xl pointer-events-none -z-10 rounded-full"></div>
  <div class="absolute top-12 left-10 w-72 h-72 bg-arcanium-purple/10 dark:bg-arcanium-purple/15 blur-2xl pointer-events-none -z-10 rounded-full"></div>
  <div class="absolute top-20 right-10 w-80 h-80 bg-arcanium-amber/10 dark:bg-arcanium-amber/15 blur-3xl pointer-events-none -z-10 rounded-full"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      
      <!-- Announce Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/90 dark:bg-arcanium-dark-card/90 border border-arcanium-border dark:border-arcanium-dark-border shadow-xs text-xs font-semibold text-arcanium-plum dark:text-arcanium-dark-text mb-6 hover:border-arcanium-purple/40 transition-colors">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Introducing Arcanium v2.4</span>
        <span class="text-arcanium-muted dark:text-arcanium-dark-muted">•</span>
        <span class="text-arcanium-purple dark:text-arcanium-purple-light font-medium flex items-center gap-1">
          Meet Liber the AI Librarian
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-heading font-bold text-4xl sm:text-5xl lg:text-6xl text-arcanium-plum dark:text-arcanium-dark-text leading-[1.12] tracking-tight">
        Your Portal to <span class="italic font-serif text-arcanium-purple dark:text-arcanium-purple-light relative inline-block">
          Infinite Stories.
          <svg class="absolute -bottom-2 left-0 w-full h-2 text-arcanium-amber/60" viewBox="0 0 100 8" preserveAspectRatio="none">
            <path d="M0,5 Q50,0 100,5" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/>
          </svg>
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-lg sm:text-xl text-arcanium-muted dark:text-arcanium-dark-muted leading-relaxed font-normal max-w-2xl mx-auto">
        The all-in-one reader app powered by an AI companion. Unify your web novels, comics, and ebooks in a single, beautiful archive.
      </p>

      <!-- CTA Buttons -->
      <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href={webAppUrl} 
          class="btn-primary w-full sm:w-auto px-8 py-4 rounded-2xl font-semibold text-base flex items-center justify-center gap-2.5 shadow-float-button group"
        >
          <span>Open Arcanium</span>
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a 
          href={discordUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-secondary w-full sm:w-auto px-7 py-4 rounded-2xl font-semibold text-base flex items-center justify-center gap-2.5 text-arcanium-plum dark:text-arcanium-dark-text hover:text-arcanium-purple"
        >
          <svg class="w-5 h-5 fill-[#5865F2]" viewBox="0 0 24 24">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Join Discord Community</span>
        </a>
      </div>

      <!-- Feature Highlight Badges -->
      <div class="mt-8 pt-6 border-t border-arcanium-border/70 dark:border-arcanium-dark-border/70 flex flex-wrap items-center justify-center gap-6 text-xs text-arcanium-muted dark:text-arcanium-dark-muted font-medium">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>Zero Ads & Distraction-Free</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-arcanium-purple dark:text-arcanium-purple-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>Universal Source Reader</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-arcanium-amber dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
          <span>Agentic AI Companion</span>
        </div>
      </div>

    </div>

    <!-- Floating High-Fidelity Hero Mockup Frame -->
    <div class="mt-12 sm:mt-16 lg:mt-20 max-w-5xl mx-auto relative">
      
      <!-- Ambient Backlight -->
      <div class="absolute -inset-1.5 bg-gradient-to-r from-arcanium-purple/30 dark:from-arcanium-purple/40 via-arcanium-amber/20 to-arcanium-purple/20 rounded-[2.5rem] blur-xl opacity-80 -z-10"></div>
      
      <!-- Outer App Window Frame -->
      <div class="bg-white dark:bg-arcanium-dark-surface rounded-2xl sm:rounded-3xl border border-arcanium-border dark:border-arcanium-dark-border shadow-2xl dark:shadow-dark-card overflow-hidden transition-all duration-300 hover:shadow-glow-purple/20">
        
        <!-- App Window Header Bar -->
        <div class="bg-arcanium-cream/80 dark:bg-arcanium-dark-card/90 border-b border-arcanium-border dark:border-arcanium-dark-border px-4 py-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#FF5F56] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#FFBD2E] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27C93F] inline-block"></span>
          </div>

          <div class="flex items-center gap-2 px-4 py-1 rounded-lg bg-white/90 dark:bg-arcanium-dark-surface/90 border border-arcanium-border dark:border-arcanium-dark-border text-xs text-arcanium-muted dark:text-arcanium-dark-muted font-mono">
            <svg class="w-3.5 h-3.5 text-arcanium-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="18" height="18" x="3" y="3" rx="2"/>
              <path d="M7 7h10M7 12h10M7 17h6"/>
            </svg>
            <span>arcanium.app/archive/dashboard</span>
          </div>

          <div class="flex items-center gap-2 text-xs font-semibold text-arcanium-plum dark:text-arcanium-dark-text">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="hidden sm:inline">Liber Online</span>
          </div>
        </div>

        <!-- App Interior Mockup Grid -->
        <div class="p-4 sm:p-6 lg:p-8 bg-[#FAF8F5] dark:bg-arcanium-dark-bg grid grid-cols-1 lg:grid-cols-12 gap-6 items-start transition-colors">
          
          <!-- Left Column: Home Dashboard UI Preview (7 Cols) -->
          <div class="lg:col-span-7 space-y-5">
            
            <!-- Dashboard Welcome Header -->
            <div class="flex items-center justify-between pb-3 border-b border-arcanium-border/80 dark:border-arcanium-dark-border/80">
              <div>
                <span class="text-xs uppercase tracking-widest font-semibold text-arcanium-muted dark:text-arcanium-dark-muted">The Archive</span>
                <h3 class="font-heading font-bold text-2xl text-arcanium-plum dark:text-arcanium-dark-text">Welcome back, Archivist</h3>
              </div>
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-arcanium-amber-light dark:bg-amber-950/40 border border-arcanium-amber/30 text-arcanium-amber text-xs font-bold shadow-xs">
                <span>🔥</span>
                <span>14 Day Streak</span>
              </div>
            </div>

            <!-- "Currently Reading" Hero Card -->
            <div class="bg-white dark:bg-arcanium-dark-card rounded-2xl p-4 sm:p-5 border border-arcanium-border dark:border-arcanium-dark-border shadow-soft-card dark:shadow-dark-card relative overflow-hidden group">
              <div class="flex gap-4 sm:gap-5 items-center">
                <div class="w-20 sm:w-24 h-28 sm:h-32 rounded-xl overflow-hidden shadow-md flex-shrink-0 relative border border-arcanium-border dark:border-arcanium-dark-border">
                  <img 
                    src="/assets/cover_archive.png" 
                    alt="The Chrono-Archivist book cover" 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  <span class="absolute top-1 left-1 bg-arcanium-plum/90 dark:bg-arcanium-purple/90 text-white text-[9px] px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">
                    Novel
                  </span>
                </div>
                
                <div class="flex-1 min-w-0 space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-[11px] font-semibold text-arcanium-purple dark:text-arcanium-purple-light bg-arcanium-purple-subtle dark:bg-purple-950/50 px-2 py-0.5 rounded-full">
                      Ch. 42 of 68
                    </span>
                    <span class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted">• 18 min left</span>
                  </div>
                  
                  <h4 class="font-heading font-bold text-lg sm:text-xl text-arcanium-plum dark:text-arcanium-dark-text truncate">
                    The Chrono-Archivist: Vol. II
                  </h4>
                  
                  <p class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted line-clamp-2">
                    "Memories drift between parchment layers, waiting for the lantern to ignite the dormant ink..."
                  </p>
                  
                  <!-- Progress Bar -->
                  <div class="pt-1">
                    <div class="flex justify-between text-[11px] font-medium text-arcanium-muted dark:text-arcanium-dark-muted mb-1">
                      <span>Reading Progress</span>
                      <span class="font-bold text-arcanium-plum dark:text-arcanium-dark-text">68%</span>
                    </div>
                    <div class="w-full h-2 bg-arcanium-cream dark:bg-arcanium-dark-surface rounded-full overflow-hidden">
                      <div class="h-full bg-gradient-to-r from-arcanium-amber to-arcanium-purple rounded-full w-[68%]"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Curated Shelves Mini Strip -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <h5 class="font-heading font-bold text-base text-arcanium-plum dark:text-arcanium-dark-text">Curated by Liber</h5>
                <span class="text-xs font-semibold text-arcanium-purple dark:text-arcanium-purple-light hover:underline cursor-pointer">View Shelf →</span>
              </div>
              <div class="grid grid-cols-3 gap-3">
                <div class="bg-white dark:bg-arcanium-dark-card p-2.5 rounded-xl border border-arcanium-border dark:border-arcanium-dark-border flex flex-col items-center text-center group cursor-pointer hover:border-arcanium-purple/40 transition-all">
                  <img src="/assets/cover_cartographer.png" alt="Book cover" class="w-12 h-16 object-cover rounded-lg shadow-xs mb-2 group-hover:scale-105 transition-transform" />
                  <span class="text-[11px] font-bold text-arcanium-plum dark:text-arcanium-dark-text truncate w-full">The Cartographer</span>
                  <span class="text-[9px] text-arcanium-muted dark:text-arcanium-dark-muted">Fantasy • 4.9★</span>
                </div>
                <div class="bg-white dark:bg-arcanium-dark-card p-2.5 rounded-xl border border-arcanium-border dark:border-arcanium-dark-border flex flex-col items-center text-center group cursor-pointer hover:border-arcanium-purple/40 transition-all">
                  <img src="/assets/cover_garden.png" alt="Book cover" class="w-12 h-16 object-cover rounded-lg shadow-xs mb-2 group-hover:scale-105 transition-transform" />
                  <span class="text-[11px] font-bold text-arcanium-plum dark:text-arcanium-dark-text truncate w-full">Midnight Garden</span>
                  <span class="text-[9px] text-arcanium-muted dark:text-arcanium-dark-muted">Mystery • 4.8★</span>
                </div>
                <div class="bg-white dark:bg-arcanium-dark-card p-2.5 rounded-xl border border-arcanium-border dark:border-arcanium-dark-border flex flex-col items-center text-center group cursor-pointer hover:border-arcanium-purple/40 transition-all">
                  <img src="/assets/cover_wind.png" alt="Book cover" class="w-12 h-16 object-cover rounded-lg shadow-xs mb-2 group-hover:scale-105 transition-transform" />
                  <span class="text-[11px] font-bold text-arcanium-plum dark:text-arcanium-dark-text truncate w-full">Whispering Wind</span>
                  <span class="text-[9px] text-arcanium-muted dark:text-arcanium-dark-muted">Sci-Fi • 4.9★</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Right Column: Liber Companion Chat Mockup (5 Cols) -->
          <div class="lg:col-span-5 bg-white dark:bg-arcanium-dark-card rounded-2xl border border-arcanium-border dark:border-arcanium-dark-border shadow-soft-card dark:shadow-dark-card p-4 sm:p-5 flex flex-col justify-between h-full space-y-4">
            
            <!-- Liber Header -->
            <div class="flex items-center justify-between pb-3 border-b border-arcanium-border dark:border-arcanium-dark-border">
              <div class="flex items-center gap-3">
                <div class="relative">
                  <img 
                    src="/assets/liber_hero.jpg" 
                    alt="Liber the Librarian" 
                    class="w-11 h-11 rounded-full object-cover border-2 border-arcanium-amber shadow-xs"
                  />
                  <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full ring-2 ring-white dark:ring-arcanium-dark-card"></span>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-heading font-bold text-base text-arcanium-plum dark:text-arcanium-dark-text">Liber</span>
                    <span class="text-[10px] bg-arcanium-purple-subtle dark:bg-purple-950/60 text-arcanium-purple dark:text-arcanium-purple-light px-1.5 py-0.2 rounded font-bold">AI Companion</span>
                  </div>
                  <span class="text-[11px] text-arcanium-muted dark:text-arcanium-dark-muted">Chief Archival Companion</span>
                </div>
              </div>

              <div class="p-1.5 rounded-lg bg-arcanium-cream dark:bg-arcanium-dark-surface text-arcanium-purple dark:text-arcanium-purple-light" title="Voice enabled">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" x2="12" y1="19" y2="22"/>
                </svg>
              </div>
            </div>

            <!-- Chat Stream Preview -->
            <div class="space-y-3 text-xs leading-relaxed">
              
              <!-- User Message -->
              <div class="flex justify-end">
                <div class="bg-arcanium-purple dark:bg-arcanium-purple text-white px-3.5 py-2.5 rounded-2xl rounded-tr-xs max-w-[85%] shadow-xs">
                  "Liber, I'm in the mood for an atmospheric mystery set in a forgotten library."
                </div>
              </div>

              <!-- Liber Message with Capybara Wisdom -->
              <div class="flex gap-2.5 items-start">
                <img 
                  src="/assets/capybara_reading.png" 
                  alt="Liber avatar" 
                  class="w-7 h-7 rounded-full bg-arcanium-amber-light dark:bg-amber-950/40 border border-arcanium-amber/40 p-0.5 flex-shrink-0"
                />
                <div class="bg-arcanium-cream/80 dark:bg-arcanium-dark-surface text-arcanium-text dark:text-arcanium-dark-text p-3 rounded-2xl rounded-tl-xs space-y-2 border border-arcanium-border/60 dark:border-arcanium-dark-border/60">
                  <p>
                    "A magnificent choice, Archivist. I have pulled <em>The Cartographer's Lament</em> from shelf 4B. The author's prose is rich with midnight tea and rain-soaked cobblestones."
                  </p>
                  
                  <div class="pt-1 flex flex-wrap gap-1.5">
                    <button class="px-2.5 py-1 rounded-lg bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border text-[11px] font-semibold text-arcanium-purple dark:text-arcanium-purple-light hover:bg-arcanium-purple hover:text-white transition-colors">
                      📖 Add to Reading Queue
                    </button>
                    <button class="px-2.5 py-1 rounded-lg bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border text-[11px] font-semibold text-arcanium-plum dark:text-arcanium-dark-text hover:bg-arcanium-cream dark:hover:bg-arcanium-dark-surface transition-colors">
                      🎙 Read aloud excerpt
                    </button>
                  </div>
                </div>
              </div>

            </div>

            <!-- Chat Input Mockup -->
            <div class="pt-2">
              <div class="flex items-center gap-2 bg-arcanium-cream/90 dark:bg-arcanium-dark-surface rounded-xl px-3 py-2 border border-arcanium-border dark:border-arcanium-dark-border">
                <input 
                  type="text" 
                  placeholder="Ask Liber anything about your stories..." 
                  class="bg-transparent text-xs text-arcanium-text dark:text-arcanium-dark-text placeholder-arcanium-muted dark:placeholder-arcanium-dark-muted w-full focus:outline-none"
                  disabled
                />
                <button class="w-7 h-7 rounded-lg bg-arcanium-purple dark:bg-arcanium-purple-light text-white flex items-center justify-center flex-shrink-0 shadow-xs">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </button>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>
