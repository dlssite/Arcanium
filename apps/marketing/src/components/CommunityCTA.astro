---
// CommunityCTA.astro
const discordUrl = import.meta.env.PUBLIC_DISCORD_URL ?? 'https://discord.gg/arcanium';
---

<section id="community" class="py-20 md:py-32 bg-[#FAF8F5] dark:bg-[#120E18] relative overflow-hidden transition-colors duration-200">
  <!-- Subtle decorative ambient circles -->
  <div class="absolute -bottom-20 -left-20 w-96 h-96 bg-arcanium-purple/10 dark:bg-arcanium-purple/20 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-96 h-96 bg-arcanium-amber/10 dark:bg-arcanium-amber/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Big Conversion Card -->
    <div class="bg-gradient-to-br from-[#FAF6EE] to-[#F4EFEB] dark:from-arcanium-dark-surface dark:to-arcanium-dark-card rounded-3xl border border-arcanium-border dark:border-arcanium-dark-border shadow-2xl dark:shadow-dark-card p-8 sm:p-12 lg:p-16 relative overflow-hidden">
      
      <!-- Top Glow Accent -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-arcanium-purple/15 dark:bg-arcanium-purple/25 rounded-full blur-2xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
        
        <!-- Left: Copy & Form -->
        <div class="lg:col-span-8 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-arcanium-dark-card border border-arcanium-border dark:border-arcanium-dark-border text-arcanium-plum dark:text-arcanium-dark-text text-xs font-bold uppercase tracking-wider shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            Early Access Cohort Open
          </div>

          <h2 class="font-heading font-bold text-3xl sm:text-4xl lg:text-5xl text-arcanium-plum dark:text-arcanium-dark-text leading-tight">
            Ready to step into the archive?
          </h2>

          <p class="text-base sm:text-lg text-arcanium-muted dark:text-arcanium-dark-muted leading-relaxed">
            Join thousands of bibliophiles, web novel addicts, comic readers, and independent authors shaping the future of digital literature.
          </p>

          <!-- Email Waitlist Form -->
          <form id="waitlist-form" class="mt-4 space-y-3 max-w-lg">
            <div class="flex flex-col sm:flex-row gap-2.5">
              <div class="relative flex-1">
                <input 
                  type="email" 
                  id="waitlist-email"
                  name="email"
                  required
                  placeholder="Enter your email address..."
                  class="w-full px-4 py-3.5 rounded-xl bg-white dark:bg-arcanium-dark-surface border border-arcanium-border dark:border-arcanium-dark-border text-sm text-arcanium-text dark:text-arcanium-dark-text placeholder-arcanium-muted dark:placeholder-arcanium-dark-muted focus:outline-none focus:ring-2 focus:ring-arcanium-purple/40 focus:border-arcanium-purple transition-all shadow-xs"
                />
              </div>
              <button 
                type="submit"
                id="waitlist-submit"
                class="btn-primary px-6 py-3.5 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 flex-shrink-0"
              >
                <span>Get Early Access Updates</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
            
            <p id="waitlist-feedback" class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted transition-all">
              🔒 We respect your quiet reading time. No spam, ever.
            </p>
          </form>

          <!-- Discord Card Highlight -->
          <div class="pt-4 flex flex-col sm:flex-row sm:items-center gap-4">
            <a 
              href={discordUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-[#5865F2] text-white hover:bg-[#4752C4] transition-all shadow-md font-semibold text-sm group"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
              <span>Join 3,400+ on Discord</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>

            <span class="text-xs text-arcanium-muted dark:text-arcanium-dark-muted">
              Book clubs, feature voting & Liber beta testing
            </span>
          </div>

        </div>

        <!-- Right: Liber Mascot Visual Anchor -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center text-center">
          <div class="relative group">
            <div class="w-48 h-48 sm:w-56 sm:h-56 rounded-full bg-gradient-to-br from-arcanium-amber-light to-white dark:from-arcanium-dark-card dark:to-arcanium-dark-surface p-2 border-2 border-arcanium-amber/40 shadow-xl overflow-hidden relative">
              <img 
                src="/assets/liber_hero.jpg" 
                alt="Liber the Librarian Mascot" 
                class="w-full h-full object-cover rounded-full group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-3.5 py-1 rounded-full bg-arcanium-plum dark:bg-arcanium-purple text-white text-xs font-bold whitespace-nowrap shadow-md border border-arcanium-amber/40">
              Liber the Librarian
            </div>
          </div>
          <p class="mt-5 text-xs text-arcanium-muted dark:text-arcanium-dark-muted italic max-w-xs">
            "We have reserved a desk in the archive with your name on it."
          </p>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('waitlist-form');
  const emailInput = document.getElementById('waitlist-email') as HTMLInputElement | null;
  const feedback = document.getElementById('waitlist-feedback');
  const submitBtn = document.getElementById('waitlist-submit');

  if (form && emailInput && feedback && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (!email) return;

      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = `<span>Saving...</span>`;

      setTimeout(() => {
        form.innerHTML = `
          <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-sm font-semibold flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>You're on the early archive roster! Welcome aboard, Archivist.</span>
          </div>
        `;
      }, 600);
    });
  }
</script>
