---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeaturePillars from '../components/FeaturePillars.astro';
import AppShowcase from '../components/AppShowcase.astro';
import ForWriters from '../components/ForWriters.astro';
import CommunityCTA from '../components/CommunityCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Arcanium — The Living Archive | Your Portal to Infinite Stories"
  description="The all-in-one reader app powered by Liber the AI Librarian companion. Unify your web novels, comics, and ebooks in a single, distraction-free archive."
>
  <Navbar />
  <main class="flex-grow">
    <Hero />
    <FeaturePillars />
    <AppShowcase />
    <ForWriters />
    <CommunityCTA />
  </main>
  <Footer />
</BaseLayout>
