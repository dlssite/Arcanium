# ── Arcanium Marketing Site ─────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.

# URL of the Arcanium web app (used for "Launch App" CTAs)
PUBLIC_WEB_APP_URL=http://localhost:3000

# Social / community links
PUBLIC_DISCORD_URL=https://discord.gg/arcanium
PUBLIC_TWITTER_URL=https://twitter.com/ArcaniumArchive
PUBLIC_GITHUB_URL=https://github.com/arcanium-archive

# Production site URL (used for canonical URLs and structured data)
PUBLIC_SITE_URL=https://arcanium.app
