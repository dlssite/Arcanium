# =============================================================================
# Arcanium — Environment Variable Manifest
# Copy this file to .env and fill in all values before running locally.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# Prisma reads this single variable for all DB operations.
# For Supabase: use the "Transaction" pooler connection string (port 6543).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/arcanium"

# For Supabase, also set the direct (non-pooled) URL for migrations:
DIRECT_URL="postgresql://postgres:password@localhost:5432/arcanium"

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="30d"

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:4000/api/v1/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"

# -----------------------------------------------------------------------------
# BACKEND SERVER
# -----------------------------------------------------------------------------
PORT="4000"
NODE_ENV="development"

# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# -----------------------------------------------------------------------------
# FRONTEND (Vite — must be prefixed VITE_ to be exposed to the browser bundle)
# -----------------------------------------------------------------------------
# The backend API URL as seen from the browser
VITE_API_BASE_URL="http://localhost:4000"

# -----------------------------------------------------------------------------
# AI HOUSEKEEPER (Feature-flagged — disabled by default)
# Set AI_PROVIDER_BASE_URL to any OpenAI-compatible endpoint
# (OpenAI, Groq, Ollama, Together.ai, etc.)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# AI HOUSEKEEPER (Feature-flagged — disabled by default)
# OpenRouter is the recommended provider — OpenAI-compatible API.
# Get your key at: https://openrouter.ai/keys
# Set FEATURE_FLAG_AI_HOUSEKEEPER=true to enable.
# -----------------------------------------------------------------------------
FEATURE_FLAG_AI_HOUSEKEEPER="false"
AI_PROVIDER_API_KEY="sk-or-your-openrouter-key"
AI_PROVIDER_BASE_URL="https://openrouter.ai/api/v1"
AI_MODEL="anthropic/claude-3.5-haiku"
# Required by OpenRouter for abuse prevention (your deployed URL or localhost)
AI_SITE_URL="http://localhost:3000"
AI_APP_NAME="Arcanium"

# -----------------------------------------------------------------------------
# FEATURE FLAGS (runtime — also stored as FeatureFlag rows in the DB)
# Set to "true" to enable. The DB flag takes precedence for server-side checks.
# -----------------------------------------------------------------------------

# Reading Circles community feature
# Enables /api/v1/community/circles/* endpoints and the /circles web app routes
FEATURE_FLAG_CIRCLES="false"

# -----------------------------------------------------------------------------
# MARKETING SITE (Astro build-time)
# -----------------------------------------------------------------------------
PUBLIC_API_BASE_URL="http://localhost:4000"
